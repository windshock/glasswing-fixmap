{
  "name": "glasswing-fixmap",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed Anthropic CVD fix commit and first patched release map",
  "type": "module",
  "bin": {
    "glasswing-fixmap": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "sync": "tsx src/cli.ts sync",
    "sync:impacts": "tsx src/cli.ts sync-impacts",
    "verify:source": "tsx src/cli.ts verify-source",
    "report": "tsx src/cli.ts report",
    "validate": "tsx src/cli.ts validate",
    "test": "tsx --test test/*.test.ts",
    "verify": "npm run check && npm test && npm run validate",
    "check:sbom": "tsx src/cli.ts check-sbom",
    "sync:ranges": "tsx src/cli.ts sync-ranges"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cyclonedx/cyclonedx-library": "10.2.0",
    "@renovatebot/pep440": "4.2.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "cheerio": "^1.1.2",
    "packageurl-js": "2.0.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/semver": "7.8.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "license": "Apache-2.0"
}
