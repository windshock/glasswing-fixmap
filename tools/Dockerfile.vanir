# Prebuilt image for tools/vanir-docker-runner. Vanir's prebuilt parsers are
# x86-64 ELF, so the image is pinned to linux/amd64. The base image digest and
# the Vanir version are pinned for reproducibility.
#   docker build --platform linux/amd64 -f tools/Dockerfile.vanir -t glasswing-vanir:latest tools
FROM --platform=linux/amd64 python:3.12-slim@sha256:e5c9fa26ffb76e11e0f054f30dc2523a2f9693f0c36c0cf1e39b27e152d899fc
RUN pip install --no-cache-dir vanir==1.1.0
ENTRYPOINT []
