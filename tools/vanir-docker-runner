#!/usr/bin/env bash
# Reusable Docker-based Vanir runner for `verify-source --vanir-runner`.
#
# Vanir ships prebuilt x86-64 ELF parsers only, so it does not run natively on
# macOS. This wrapper runs the real Vanir detector in a linux/amd64 container,
# bind-mounting the exact host paths the verifier passes so the signature files,
# the report prefix, and the source tree resolve identically inside the
# container. It is a drop-in for the `runner` the VanirVerifier execFile()s:
#
#   glasswing-fixmap verify-source \
#     --ant ANT-2026-XXXX --source ./checkout \
#     --vanir-runner tools/vanir-docker-runner \
#     --vanir-signatures sigs.osv.json
#
# Build the image once (fast subsequent runs):
#   docker build -f tools/Dockerfile.vanir -t glasswing-vanir:latest tools
# Override the image with GLASSWING_VANIR_IMAGE if desired.
#
# macOS note: the report prefix lives under the system temp dir; Docker Desktop
# must be allowed to share it (Settings -> Resources -> File Sharing). /Users and
# /private are shared by default.
set -euo pipefail

image="${GLASSWING_VANIR_IMAGE:-glasswing-vanir:latest}"
# Bash 3.2 (the macOS default) has no associative arrays, so directory modes are
# tracked with `:`-delimited strings and an ordered list.
order=()
seen=":"
writable=":"

add_mount() {
  # Mount the containing directory even when the target itself does not exist
  # yet (the report prefix is a path Vanir writes to). `mode` is `ro` for the
  # source tree and signature files and `rw` only for the report directory, so
  # the inspection stays read-only except where Vanir must emit its report.
  local target="$1" mode="$2" dir
  if [ -d "$target" ]; then dir="$target"; else dir="$(dirname "$target")"; fi
  [ -d "$dir" ] || return 0
  dir="$(cd "$dir" && pwd)"
  # A directory needed for both input and the report must be writable.
  if [ "$mode" = "rw" ]; then
    case "$writable" in *":$dir:"*) : ;; *) writable="$writable$dir:" ;; esac
  fi
  case "$seen" in *":$dir:"*) return 0 ;; esac
  seen="$seen$dir:"
  order+=("$dir")
}

for arg in "$@"; do
  case "$arg" in
    --vulnerability_file_name=*) add_mount "${arg#*=}" ro ;;
    --report_file_name_prefix=*) add_mount "${arg#*=}" rw ;;
    /*) add_mount "$arg" ro ;;
  esac
done

mounts=()
for dir in "${order[@]}"; do
  case "$writable" in
    *":$dir:"*) mounts+=(-v "$dir:$dir:rw") ;;
    *) mounts+=(-v "$dir:$dir:ro") ;;
  esac
done

# Preserve Glasswing's read-only inspection principle: no network, a read-only
# container root (with a writable tmpfs for Vanir's scratch space), all
# capabilities dropped, and no privilege escalation. Source and signature mounts
# are :ro; only the report directory is :rw.
exec docker run --rm --platform linux/amd64 \
  --network=none \
  --read-only --tmpfs /tmp:rw,exec \
  --cap-drop=ALL \
  --security-opt=no-new-privileges \
  "${mounts[@]}" "$image" \
  python -m vanir.detector_runner "$@"
