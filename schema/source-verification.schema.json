{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/windshock/glasswing-fixmap/raw/main/schema/source-verification.schema.json",
  "title": "glasswing-fixmap source verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ant_id",
    "source",
    "impact_schema_version",
    "targets",
    "backend_results",
    "decision",
    "confidence",
    "reasons"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "ant_id": { "type": "string", "pattern": "^ANT-[0-9]{4}-[A-Z0-9]+$" },
    "source": { "type": "string", "minLength": 1 },
    "impact_schema_version": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "backend_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/backendResult" }
    },
    "decision": {
      "enum": [
        "VERIFIED_FIXED",
        "TARGET_ABSENT",
        "PATCH_NOT_FOUND",
        "AFFECTED",
        "UNKNOWN",
        "ERROR"
      ]
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reason" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": { "enum": ["git", "file", "signature", "configuration"] },
        "locator": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "strength", "detail", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "SOURCE_REPOSITORY_MATCH",
            "SOURCE_REPOSITORY_MISMATCH",
            "SOURCE_TREE_PARTIAL",
            "FIX_COMMIT_ANCESTOR",
            "FIX_COMMIT_NOT_ANCESTOR",
            "FIX_POSTIMAGE_PRESENT",
            "FIX_PREIMAGE_PRESENT",
            "VULNERABLE_PATTERN_PRESENT",
            "VULNERABLE_PATTERN_ABSENT",
            "PATCH_SIGNATURE_ABSENT",
            "TARGET_FILE_ABSENT",
            "TARGET_PATH_MOVED",
            "IMPACT_INCOMPLETE",
            "BACKEND_UNSUPPORTED",
            "BACKEND_ERROR"
          ]
        },
        "strength": { "enum": ["strong", "moderate", "weak", "informational"] },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "target_file": { "type": "string", "minLength": 1 },
        "actual_file": { "type": "string", "minLength": 1 },
        "hunk_index": { "type": "integer", "minimum": 0 },
        "detail": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "backendResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "execution_status", "observations", "warnings"],
      "properties": {
        "backend": { "$ref": "#/$defs/backend" },
        "execution_status": { "enum": ["completed", "unsupported", "error"] },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail", "observation_ids"],
      "properties": {
        "code": {
          "enum": [
            "NATIVE_POSTIMAGE_MATCH",
            "ANCESTRY_CORROBORATED",
            "PREIMAGE_PRESENT",
            "PATCH_SIGNATURE_ABSENT",
            "TARGET_ABSENT",
            "VERIFIER_CONFLICT",
            "INSUFFICIENT_EVIDENCE",
            "BACKEND_FAILURE"
          ]
        },
        "detail": { "type": "string", "minLength": 1 },
        "observation_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
