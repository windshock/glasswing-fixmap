{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/windshock/glasswing-fixmap/raw/main/schema/fix-impacts.schema.json",
  "title": "glasswing-fixmap fix impact dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "impacts"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "impacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixImpact" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url"],
      "properties": {
        "source": {
          "enum": [
            "anthropic_ledger",
            "anthropic_finding",
            "github_advisory_database",
            "cve_list_v5",
            "osv",
            "github_repository",
            "manual_override"
          ]
        },
        "url": { "type": "string", "pattern": "^https?://" },
        "locator": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "lineRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "count"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "kind", "digest", "line_count", "normalized_length"],
      "properties": {
        "algorithm": { "const": "glasswing-normalized-sha256-v1" },
        "kind": {
          "enum": [
            "added",
            "deleted",
            "unchanged_context",
            "preimage",
            "postimage",
            "combined"
          ]
        },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "line_count": { "type": "integer", "minimum": 0 },
        "normalized_length": { "type": "integer", "minimum": 1 }
      }
    },
    "hunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old_range", "new_range", "signatures"],
      "properties": {
        "old_range": { "$ref": "#/$defs/lineRange" },
        "new_range": { "$ref": "#/$defs/lineRange" },
        "context": { "type": "string", "minLength": 1 },
        "signatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/signature" }
        }
      }
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "patch_available", "hunks"],
      "properties": {
        "path_before": { "type": "string", "minLength": 1 },
        "path_after": { "type": "string", "minLength": 1 },
        "status": { "enum": ["added", "modified", "deleted", "renamed"] },
        "patch_available": { "type": "boolean" },
        "functions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "hunks": {
          "type": "array",
          "items": { "$ref": "#/$defs/hunk" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "added" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "path_after": { "type": "string", "minLength": 1 } },
            "required": ["path_after"]
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "deleted" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "path_before": { "type": "string", "minLength": 1 } },
            "required": ["path_before"]
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "renamed" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "path_before": { "type": "string", "minLength": 1 },
              "path_after": { "type": "string", "minLength": 1 }
            },
            "required": ["path_before", "path_after"]
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "modified" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "path_before": { "type": "string", "minLength": 1 },
              "path_after": { "type": "string", "minLength": 1 }
            },
            "required": ["path_before", "path_after"]
          }
        },
        {
          "if": {
            "properties": { "patch_available": { "const": false } },
            "required": ["patch_available"]
          },
          "then": { "properties": { "hunks": { "type": "array", "maxItems": 0 } } }
        }
      ]
    },
    "fixImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "ant_ids",
        "extraction_status",
        "files",
        "evidence",
        "warnings"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "ant_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ANT-[0-9]{4}-[A-Z0-9]+$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "extraction_status": { "enum": ["complete", "partial", "error"] },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/changedFile" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" },
          "minItems": 1
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "relation": { "enum": ["all_of", "any_of"] },
        "branch": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "extraction_status": { "const": "complete" } },
            "required": ["extraction_status"]
          },
          "then": {
            "properties": {
              "files": { "type": "array", "minItems": 1 },
              "warnings": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "extraction_status": { "const": "partial" } },
            "required": ["extraction_status"]
          },
          "then": { "properties": { "warnings": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": {
            "properties": { "extraction_status": { "const": "error" } },
            "required": ["extraction_status"]
          },
          "then": {
            "properties": {
              "files": { "type": "array", "maxItems": 0 },
              "warnings": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generated_from",
        "finding_count",
        "impact_count",
        "complete_count",
        "partial_count",
        "error_count"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "generated_from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixmap_schema_version", "source_as_of", "source_url"],
          "properties": {
            "fixmap_schema_version": { "type": "string", "minLength": 1 },
            "source_as_of": { "type": "string", "minLength": 1 },
            "source_revision": { "anyOf": [{ "type": "number" }, { "type": "string" }, { "type": "null" }] },
            "source_manifest_sha3": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "source_url": { "type": "string", "pattern": "^https?://" }
          }
        },
        "finding_count": { "type": "integer", "minimum": 0 },
        "impact_count": { "type": "integer", "minimum": 0 },
        "complete_count": { "type": "integer", "minimum": 0 },
        "partial_count": { "type": "integer", "minimum": 0 },
        "error_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
